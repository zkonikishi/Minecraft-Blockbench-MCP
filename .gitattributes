* text=auto
*.ts text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
# Vendor snapshots are stored as LF so the committed bytes stay byte-identical to
# the pinned upstream sources recorded in upstream-lock.json on every OS.
vendor/** text eol=lf
vendor/ysmparser/*.wasm binary
