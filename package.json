{
  "name": "minecraft-blockbench-mcp",
  "version": "1.1.1",
  "private": true,
  "description": "Unified desktop and Web Blockbench MCP for BetterModel, ModelEngine and CraftEngine authoring",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:upstream": "node scripts/upstream-tests.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "test:web": "node scripts/web-acceptance.mjs",
    "start": "node --env-file-if-exists=.env relay/cli.mjs",
    "test:jason": "node scripts/jason-tests.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "ws": "8.21.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.25.12",
    "three": "^0.181.1",
    "typescript": "5.9.3",
    "zod-upstream-test": "npm:zod@3.25.76",
    "mcp-sdk-upstream-test": "npm:@modelcontextprotocol/sdk@1.30.0",
    "zod-to-json-schema": "3.25.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zkonikishi/Minecraft-Blockbench-MCP.git"
  }
}
